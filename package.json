{
  "name": "kmymoney-mcp",
  "version": "0.1.1",
  "description": "MCP server for KMyMoney personal-finance files (.kmy)",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kmymoney",
    "personal-finance",
    "finance"
  ],
  "homepage": "https://github.com/elluvium/kmymoney-mcp#readme",
  "bugs": {
    "url": "https://github.com/elluvium/kmymoney-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elluvium/kmymoney-mcp.git"
  },
  "bin": {
    "kmymoney-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "big.js": "^6.2.2",
    "fast-xml-parser": "^4.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
